# Base URL used by the reusable API client. The in-process default is http://testserver.
BASE_URL=http://testserver
# Logical environment label included in configuration (for example: local, staging).
TEST_ENV=local
# Per-request timeout in seconds.
REQUEST_TIMEOUT=5
# Client-observed single-request latency threshold in milliseconds.
MAX_LATENCY_MS=500
# Opt in to model-judged DeepEval tests; credentials/model configuration are also required.
RUN_LLM_EVALS=false
# Opt in to Playwright tests; the FastAPI server and browser must be installed.
RUN_UI_TESTS=false
# URL used by Playwright when browser tests are enabled.
UI_BASE_URL=http://127.0.0.1:8000
# Optional DeepEval model name. Provider credentials are read by DeepEval, never logged here.
DEEPEVAL_MODEL=
